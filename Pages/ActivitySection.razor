@using Tap.Client.Models
@using Tap.Client.Services
@inject ILocalTimeTrackingService TrackingService

<section class="activity-section">
    <div class="activity-header">
        <h2>Sessions</h2>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button class="btn btn-outline btn-sm" @onclick="ExportData">
                <span class="sync-icon">⬇</span> Export record.md
            </button>
            <label class="btn btn-outline btn-sm" style="cursor: pointer; margin: 0;">
                <InputFile OnChange="LoadFile" accept=".md" style="display: none;" />
                <span class="sync-icon">⬆</span> Load record.md
            </label>
            <button class="btn btn-secondary btn-sm" @onclick="ClearData" style="background-color: transparent; border: 1px solid var(--danger); color: var(--danger);">
                Clear
            </button>
        </div>
    </div>
    
    <div class="table-container" style="overflow-x: auto;">
        <table class="activity-table">
            <thead>
                <tr>
                    <th>Clock In</th>
                    <th>Clock Out</th>
                    @foreach (var col in SchemaColumns)
                    {
                        <th>@col</th>
                    }
                    <th>Duration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Records.OrderByDescending(r => r.InTime))
                {
                    <tr>
                        <td style="white-space: nowrap;">@record.InTime.ToString("M/d hh:mm tt")</td>
                        <td style="white-space: nowrap;">@(record.IsActive ? "ACTIVE" : record.OutTime!.Value.ToString("M/d hh:mm tt"))</td>
                        @foreach (var col in SchemaColumns)
                        {
                            <td>@(record.CustomFields.ContainsKey(col) ? record.CustomFields[col] : "")</td>
                        }
                        <td style="white-space: nowrap;">
                            @if (record.IsActive)
                            {
                                <span class="status-badge status-pending">In Progress</span>
                            }
                            else
                            {
                                <span style="font-weight: 500;">@Math.Floor(record.Duration!.Value.TotalHours)h @record.Duration!.Value.Minutes m</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter]
    public List<SessionRecord> Records { get; set; } = new();

    [Parameter]
    public EventCallback OnSyncComplete { get; set; }

    private List<string> SchemaColumns = new();

    protected override async Task OnInitializedAsync()
    {
        SchemaColumns = await TrackingService.GetSchemaColumnsAsync();
    }

    private async Task ExportData()
    {
        var success = await TrackingService.ExportToMarkdownAsync();
        if (success)
        {
            await OnSyncComplete.InvokeAsync();
        }
    }

    private async Task ClearData()
    {
        await TrackingService.ClearAllRecordsAsync();
        await OnSyncComplete.InvokeAsync();
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 512000); // 500kb max
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            
            await TrackingService.LoadFromMarkdownAsync(content);
            await OnSyncComplete.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading file: {ex.Message}");
        }
    }
}
